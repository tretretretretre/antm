{
  "name": "AINTM Daily Content Factory",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "triggerAtHour": 6, "triggerAtMinute": 0 }] }
      },
      "name": "Every day 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8484/run/ingest",
        "options": { "timeout": 300000 }
      },
      "name": "Ingest news",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8484/run/script",
        "options": { "timeout": 700000 }
      },
      "name": "Rank + write script (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8484/run/episode",
        "options": { "timeout": 20000 }
      },
      "name": "Load episode",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "chatId": "={{ $env.AINTM_TG_CHAT_ID }}",
        "message": "=🎬 TODAY'S SCRIPT ({{ JSON.parse($json.stdout).girl_name }}):\n\n{{ JSON.parse($json.stdout).headline }}\n\n{{ JSON.parse($json.stdout).script }}\n\nSource: {{ JSON.parse($json.stdout).chosen_story.url }}",
        "responseType": "approval",
        "options": {}
      },
      "name": "Approve script?",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        }
      },
      "name": "Script approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8484/run/render",
        "options": { "timeout": 900000 }
      },
      "name": "Render video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -100]
    },
    {
      "parameters": {
        "fileSelector": "/data/output/today.mp4",
        "options": {}
      },
      "name": "Read video file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1540, -100]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendVideo",
        "chatId": "={{ $env.AINTM_TG_CHAT_ID }}",
        "binaryData": true,
        "additionalFields": {}
      },
      "name": "Send video preview",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1760, -100]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "chatId": "={{ $env.AINTM_TG_CHAT_ID }}",
        "message": "📤 Post this video to all connected platforms at peak times?",
        "responseType": "approval",
        "options": {}
      },
      "name": "Approve video?",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1980, -100]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        }
      },
      "name": "Video approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2200, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8484/run/post",
        "options": { "timeout": 300000 }
      },
      "name": "Schedule posts (Postiz)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, -200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.AINTM_TG_CHAT_ID }}",
        "text": "=✅ Done: {{ $json.stdout }}",
        "additionalFields": {}
      },
      "name": "Confirm scheduled",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2640, -200]
    }
  ],
  "connections": {
    "Every day 06:00": { "main": [[{ "node": "Ingest news", "type": "main", "index": 0 }]] },
    "Ingest news": { "main": [[{ "node": "Rank + write script (Claude)", "type": "main", "index": 0 }]] },
    "Rank + write script (Claude)": { "main": [[{ "node": "Load episode", "type": "main", "index": 0 }]] },
    "Load episode": { "main": [[{ "node": "Approve script?", "type": "main", "index": 0 }]] },
    "Approve script?": { "main": [[{ "node": "Script approved?", "type": "main", "index": 0 }]] },
    "Script approved?": { "main": [[{ "node": "Render video", "type": "main", "index": 0 }], []] },
    "Render video": { "main": [[{ "node": "Read video file", "type": "main", "index": 0 }]] },
    "Read video file": { "main": [[{ "node": "Send video preview", "type": "main", "index": 0 }]] },
    "Send video preview": { "main": [[{ "node": "Approve video?", "type": "main", "index": 0 }]] },
    "Approve video?": { "main": [[{ "node": "Video approved?", "type": "main", "index": 0 }]] },
    "Video approved?": { "main": [[{ "node": "Schedule posts (Postiz)", "type": "main", "index": 0 }], []] },
    "Schedule posts (Postiz)": { "main": [[{ "node": "Confirm scheduled", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
